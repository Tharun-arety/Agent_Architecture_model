# Copy to .env.local. Never commit .env.local.

# ---------------------------------------------------------------------------
# Neon Postgres  (required)
# ---------------------------------------------------------------------------
# Create a NEW database for this project. Do not point it at another project's
# database. Neon dashboard -> project -> Connection Details -> Connection string.
# The `vector` extension is available on Neon by default; schema.sql enables it.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# OpenAI  (required — this project has no stub mode)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=""

# Router + both spokes. Classification and function calling over structured
# results, so the cheap tier is the right tool rather than merely the affordable
# one. Every model id lives in .env; none is hard-coded in the source.
OPENAI_MODEL="gpt-4o-mini"

# Final answer only; falls back to OPENAI_MODEL when empty. One call per turn,
# so this is the one worth upgrading on its own.
OPENAI_SYNTHESIS_MODEL=""

# 1536-dim. Changing the width requires editing vector(1536) in schema.sql and
# re-running the ingest.
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ---------------------------------------------------------------------------
# Guardrails
# ---------------------------------------------------------------------------
# Cosine similarity below which a retrieved chunk never reaches the model.
#
# Measured, not chosen: `npx tsx evals/calibrate.ts` sweeps this against the
# retrieval golden set and reports recall versus leak at each candidate. For
# text-embedding-3-small over this corpus, 0.30-0.40 is the plateau where every
# in-corpus question still finds its document and no off-corpus question finds
# anything; 0.35 is its midpoint.
#
# This number is specific to the embedding model AND the corpus. Re-run the
# calibration if you change either. A plausible-looking 0.70 scores 8% recall
# here — it refuses almost everything.
GROUNDING_SIMILARITY_FLOOR=0.35

# Hard ceiling on the tool-calling loop, and on how many times a rejected tool
# call may be handed back to the model for correction.
AGENT_MAX_TOOL_ITERATIONS=3
AGENT_MAX_ARG_RETRIES=2

# ---------------------------------------------------------------------------
# Public deployment
# ---------------------------------------------------------------------------
# /api/chat is unauthenticated and spends a real API key. Both caps apply.
RATE_LIMIT_PER_MINUTE=10
MAX_OUTPUT_TOKENS=700
